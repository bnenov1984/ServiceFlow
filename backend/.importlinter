[importlinter]
root_package = serviceflow

; ADR-001: domain modules never import platform (03 par.5 dependency direction).
; serviceflow.dashboard added 18.07.2026 (docs/business-os/13, Phase 1 audit):
; it was missing from source_modules, so a dashboard -> platform import was not
; a violation of any other listed source and went undetected (proven by a
; mutation test — see BOS-13). Not caught transitively, since forbidden-contract
; checking only walks forward from declared sources.
[importlinter:contract:domain-not-platform]
name = Domain modules must not import platform
type = forbidden
source_modules =
    serviceflow.identity
    serviceflow.customers
    serviceflow.assets
    serviceflow.service_orders
    serviceflow.commercial
    serviceflow.timeline
    serviceflow.attachments
    serviceflow.contacts
    serviceflow.search
    serviceflow.tasks
    serviceflow.dashboard
forbidden_modules =
    serviceflow.platform

; shared_kernel is the bottom layer: imports nothing from the application.
; serviceflow.dashboard added 18.07.2026 (docs/business-os/13, Phase 1 audit):
; it was missing from forbidden_modules. A mutation test showed this contract
; still caught a shared_kernel -> dashboard import today (transitively, via
; dashboard's own imports of already-forbidden modules) — but that detection
; is incidental, not structural, so dashboard is now listed explicitly too.
[importlinter:contract:shared-kernel-bottom]
name = shared_kernel imports nothing above it
type = forbidden
source_modules =
    serviceflow.shared_kernel
forbidden_modules =
    serviceflow.identity
    serviceflow.customers
    serviceflow.assets
    serviceflow.service_orders
    serviceflow.commercial
    serviceflow.timeline
    serviceflow.attachments
    serviceflow.contacts
    serviceflow.search
    serviceflow.tasks
    serviceflow.dashboard
    serviceflow.platform
    serviceflow.main
    serviceflow.config

; Business OS Phase 1 (docs/business-os/04 §2 rule R3, ADR-BOS-002): Core
; (identity, platform) must never import a vertical or shared module. This is
; already true today (Core imports only shared_kernel/config) — this contract
; ratchets that fact so it cannot regress silently. See
; docs/business-os/12_PHASE_1_IMPLEMENTATION.md.
[importlinter:contract:core-not-modules]
name = Business OS Core (identity, platform) must not import ServiceFlow modules
type = forbidden
source_modules =
    serviceflow.identity
    serviceflow.platform
forbidden_modules =
    serviceflow.customers
    serviceflow.assets
    serviceflow.service_orders
    serviceflow.commercial
    serviceflow.timeline
    serviceflow.attachments
    serviceflow.contacts
    serviceflow.search
    serviceflow.tasks
    serviceflow.dashboard

; Business OS Phase 3 (docs/business-os/16): Identity's public contract is
; identity.deps + identity.contracts only. `type = protected` (not
; `forbidden`): a `forbidden` contract walks the full transitive closure, so
; every external router would be flagged for merely depending on
; identity.deps, which itself legitimately imports identity.service/.models
; internally — that is implementation, not a violation. `protected` instead
; checks only DIRECT imports of the protected modules (grimp
; find_modules_that_directly_import), which is the right semantic: identity's
; own submodules (deps, contracts, and the protected ones importing each
; other) stay free; main.py/seed.py (composition root) are explicitly listed
; since they are not descendants of serviceflow.identity. Zero violations
; existed at audit time after migrating the one found
; (service_orders/router.py -> identity.service.get_company, moved to
; identity.contracts.get_company_profile) — enforced directly, no baseline.
[importlinter:contract:identity-public-boundary]
name = External modules must use identity's public contract only
type = protected
protected_modules =
    serviceflow.identity.models
    serviceflow.identity.service
    serviceflow.identity.security
    serviceflow.identity.router
allowed_importers =
    serviceflow.identity
    serviceflow.main
    serviceflow.seed

; Finer independence contracts tighten in Stage 1 when real module code exists.
